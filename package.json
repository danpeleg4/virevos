{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "npx prettier --write .",
    "test-semantic-search": "node scripts/test-semantic-search.ts",
    "test-vector-upload": "node scripts/test-vector-upload.ts",
    "test-vector-create": "node scripts/test-vector-create.ts",
    "test-weekly-summary": "node scripts/test-weekly-summary-cron.ts",
    "livekit:typecheck": "tsc -p livekit/tsconfig.json --noEmit",
    "livekit:build": "esbuild livekit/src/agent/agent.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=livekit/dist/agent.mjs",
    "livekit:download-files": "node livekit/dist/agent.mjs download-files",
    "livekit:start": "node livekit/dist/agent.mjs start"
  },
  "overrides": {
    "esbuild": "^0.27.0",
    "minimatch": ">=10.2.3",
    "postcss": "$postcss"
  },
  "dependencies": {
    "@livekit/agents": "^1.4.9",
    "@livekit/agents-plugin-openai": "^1.4.9",
    "@livekit/agents-plugin-silero": "^1.4.9",
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^7.0.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.3",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "esbuild": "^0.27.0",
    "fast-xml-parser": "5.7.0",
    "isomorphic-dompurify": "^3.12.0",
    "livekit-client": "^2.16.1",
    "livekit-server-sdk": "^2.15.0",
    "lucide-react": "^0.487.0",
    "motion": "^12.24.10",
    "next": "^16.0.10",
    "next-themes": "^0.4.6",
    "openai": "^6.15.0",
    "postgres": "^3.4.7",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0"
